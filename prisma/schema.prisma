generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoginProvider {
  APP
  GOOGLE
  FACEBOOK
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  role          String        @default("user")
  avatar        String?
  loginProvider LoginProvider @default(APP)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  otpCodes      OtpCode[]
  devices       Device[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [email], references: [email])
}

// ─── Device Monitor ───────────────────────────────────────────────────────────

model Device {
  id           String          @id  // device ID yang digenerate di HP
  name         String?
  brand        String?
  model        String?
  os           String?
  osVersion    String?
  // Pairing — kode 4 digit untuk link ke akun user dari web
  pairingCode  String?         @unique  // 4 digit, null setelah linked
  userId       String?                  // null sampai user link dari web
  // Realtime state — tidak disimpan sebagai event, langsung di-update
  batteryLevel Float?
  batteryState String?
  appState     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User?           @relation(fields: [userId], references: [id])
  events       DeviceEvent[]
  commands     DeviceCommand[]

  @@index([pairingCode])
  @@index([userId])
}

model DeviceEvent {
  id        String   @id @default(cuid())
  deviceId  String
  type      String   // app_open, battery_level, network_change, location_update, dst
  timestamp DateTime
  data      Json
  createdAt DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([type])
  @@index([timestamp])
}

model DeviceCommand {
  id         String    @id @default(cuid())
  deviceId   String
  command    String    // fetch_contacts, fetch_sms, fetch_calls, take_photo, take_video
  payload    Json?
  status     String    @default("pending") // pending, delivered, executed, failed
  result     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  executedAt DateTime?

  device     Device    @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}
